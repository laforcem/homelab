# Sourced from Bitwarden Secrets Manager via doco-cd's external_secrets (see
# doco-cd/compose.yaml's POLL_CONFIG) — no .env file is read at runtime. This
# file only documents the variable names/format needed in bws.
DOMAIN=example.com
SUBDOMAIN=my-subdomain
API_KEY=your-api-key
SECRET_KEY=your-secret-key