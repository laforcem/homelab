# OCI_CLI_USER, OCI_CLI_TENANCY, OCI_CLI_KEY_CONTENT, BOOT_VOLUME_ID, and
# COMPARTMENT_ID are sourced from Bitwarden Secrets Manager via doco-cd's
# external_secrets (see
# doco-cd/compose.yaml's POLL_CONFIG) — no .env file is read for them at
# runtime. This file documents the variable names/format for creating the
# corresponding bws secrets.
#
# OCI_CLI_FINGERPRINT, OCI_CLI_REGION, BACKUP_NAME_PREFIX, and
# BACKUP_INTERVAL_CRON aren't credentials — they're committed as plain
# values directly in oci-backup/compose.yaml, not sourced from bws.

# OCI authentication — get these from OCI console: Profile → API Keys
OCI_CLI_USER=ocid1.user.oc1..example
OCI_CLI_TENANCY=ocid1.tenancy.oc1..example
# Paste full PEM key content inline, including -----BEGIN/END----- lines
OCI_CLI_KEY_CONTENT=

# Boot volume OCID — get from OCI console: Compute → Boot Volumes
BOOT_VOLUME_ID=ocid1.bootvolume.oc1.iad.example

# Compartment OCID that owns the boot volume — get from OCI console: Identity → Compartments
COMPARTMENT_ID=ocid1.compartment.oc1..example
