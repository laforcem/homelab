*.lan.{$DOMAIN} {
    tls {
        dns porkbun {
            api_key {$API_KEY}
            api_secret_key {$SECRET_KEY}
        }
    }
    @adguard host adguard.lan.{$DOMAIN}
    handle @adguard {
        reverse_proxy adguard-home:80
    }
    @grafana host grafana.lan.{$DOMAIN}
    handle @grafana {
        reverse_proxy monitoring-grafana:3000
    }
    @speedtest host speedtest.lan.{$DOMAIN}
    handle @speedtest {
        # Prometheus scrapes /prometheus container-to-container, not through here.
        @metrics path /prometheus*
        respond @metrics 404
        reverse_proxy speedtest-tracker:80
    }
    @openclaw host openclaw.lan.{$DOMAIN}
    handle @openclaw {
        reverse_proxy 192.168.10.14:18789 {
            transport http {
                tls
                tls_insecure_skip_verify
            }
        }
    }

    handle {
        abort
    }
}
