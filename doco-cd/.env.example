# This is the ONLY secret file this VM needs, ever — a genuine host-side
# file at a fixed path, bind-mounted into doco-cd (see compose.yaml's
# `/opt/doco-cd-secrets:/secrets:ro` mount), NOT something placed inside
# doco-cd's own git-checkout /data volume. Everything doco-cd deploys gets
# its secrets from Bitwarden Secrets Manager via external_secrets in
# POLL_CONFIG — this token is what authenticates to bws in the first place,
# so it can't itself come from bws.
#
# On constrainer, create the directory and file once:
#   sudo mkdir -p /opt/doco-cd-secrets
#   sudo vim /opt/doco-cd-secrets/doco-cd.env
#
# Bitwarden Secrets Manager machine account access token, scoped to the
# homelab bws project (see docs/current-state.md for the secrets management
# convention).
SECRET_PROVIDER_ACCESS_TOKEN=
