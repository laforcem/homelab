# Sourced from Bitwarden Secrets Manager via doco-cd's external_secrets (see
# doco-cd/compose.yaml's POLL_CONFIG) — no .env file is read at runtime. This
# file only documents the variable names/format needed in bws.
PPLD_CARD_NUMBER=your-library-card-number
PPLD_PIN=your-library-pin
CALDAV_USERNAME=you@example.com
CALDAV_APP_PASSWORD=fastmail-app-password-with-calendars-access
# Full calendar collection URL (Fastmail: Settings > Calendars > calendar's Export link)
CALDAV_CALENDAR_URL=https://caldav.fastmail.com/dav/calendars/user/you@example.com/CALENDAR-ID/
# healthchecks.io ping URL; "/fail" is appended on failure
HEALTHCHECK_URL=https://hc-ping.com/your-check-uuid
