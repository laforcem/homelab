LASTFM_API_KEY=your_lastfm_api_key_here
LASTFM_SECRET=your_lastfm_secret_here
DOMAIN=example.com
AUDIOMUSEAI_PLUGIN_VERSION=v8
APPLE_MUSIC_PLUGIN_VERSION=v0.2.0

# AudioMuse-AI core service (the analysis/recommendation backend the plugin talks to)
AUDIOMUSE_POSTGRES_USER=audiomuse
AUDIOMUSE_POSTGRES_PASSWORD=change_me

# Dedicated Navidrome service account AudioMuse-AI uses to read your library
AUDIOMUSE_NAVIDROME_USER=audiomuse
AUDIOMUSE_NAVIDROME_PASSWORD=change_me

# AudioMuse-AI's own admin login (for its web UI)
AUDIOMUSE_ADMIN_USER=admin
AUDIOMUSE_ADMIN_PASSWORD=change_me
AUDIOMUSE_JWT_SECRET=change_me_to_a_random_secret

# Bearer token the Navidrome plugin uses for server-to-server API calls (AUTH_ENABLED requires this)
AUDIOMUSE_API_TOKEN=change_me_to_a_random_token

# Animated Apple Music cover art (m8tec/animated-artwork-downloader): scans /mnt/lab/music
# on an interval and writes cover.webp into album folders missing one. To opt an album out,
# save the album's REAL cover art (not a placeholder) as cover.webp in its folder yourself --
# the scanner skips folders that already have one, but cover.* is Navidrome's top-priority art
# source (ND_COVERARTPRIORITY default: cover.*,folder.*,front.*,embedded,external), so a blank
# placeholder there would replace the album's real art instead of just blocking the fetcher.
ANIMATED_COVER_RESCAN_INTERVAL_MINUTES=1440
ANIMATED_COVER_API_DELAY_MS=2000
ANIMATED_COVER_MIN_RESOLUTION=1000
ANIMATED_COVER_WEBP_QUALITY=50
