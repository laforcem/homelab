*.lan.{$DOMAIN} {
    tls {
        dns porkbun {
            api_key {$API_KEY}
            api_secret_key {$SECRET_KEY}
        }
    }
    @adguard host adguard.lan.{$DOMAIN}
    handle @adguard {
        reverse_proxy adguard-home:80
    }
    @grafana host grafana.lan.{$DOMAIN}
    handle @grafana {
        reverse_proxy monitoring-grafana:3000
    }
    @speedtest host speedtest.lan.{$DOMAIN}
    handle @speedtest {
        # Prometheus scrapes /prometheus container-to-container, not through here.
        @metrics path /prometheus*
        respond @metrics 404
        reverse_proxy speedtest-tracker:80
    }
    @openclaw host openclaw.lan.{$DOMAIN}
    handle @openclaw {
        reverse_proxy 192.168.10.14:18789 {
            transport http {
                tls
                tls_insecure_skip_verify
            }
        }
    }

    @audiomuse host audiomuse.lan.{$DOMAIN}
    handle @audiomuse {
        # Runs on chimaera; its NodePort is restricted to warden (see
        # k3s/apps/navidrome/audiomuse-flask.yaml).
        reverse_proxy 192.168.40.10:30800
    }

    @flux host flux.lan.{$DOMAIN}
    handle @flux {
        # Flux dashboard on chimaera. It runs as one fixed identity that can
        # reconcile and restart workloads, so this login is the only gate.
        # The NodePort is restricted to warden by
        # k3s/infra/flux/dashboard/web.networkpolicy.yaml, so there is no way
        # around it. Hash and password: Bitwarden flux_ui_basic_auth_hash and
        # flux_ui_password (user name: flux).
        basic_auth {
            flux {$FLUX_UI_HASH}
        }
        reverse_proxy 192.168.40.10:30200
    }

    @mass host mass.lan.{$DOMAIN}
    handle @mass {
        # Host-network container; ufw allows 8095 from caddy-internal only.
        reverse_proxy host.docker.internal:8095
    }

    handle {
        abort
    }
}
